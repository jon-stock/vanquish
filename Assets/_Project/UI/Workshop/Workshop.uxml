<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <ui:Style src="Workshop.uss" />
    <ui:VisualElement name="root" class="root">
        <ui:VisualElement name="currency-bar" class="currency-bar">
            <ui:Label name="currency-label" text="Currency: 0" />
            <ui:Button name="debug-add-currency-button" text="+10,000 (Debug)" class="debug-currency-button" />
        </ui:VisualElement>
        <ui:VisualElement name="main-row" class="main-row">
            <ui:VisualElement name="part-picker-panel" class="panel">
                <ui:VisualElement name="designer-mode-tabs" class="designer-mode-tabs">
                    <ui:Button name="mode-tab-craft" text="Craft" class="designer-mode-tab" />
                    <ui:Button name="mode-tab-missile" text="Missile" class="designer-mode-tab" />
                    <ui:Button name="mode-tab-research" text="Research" class="designer-mode-tab" />
                </ui:VisualElement>
                <ui:ScrollView name="part-picker-scroll" class="part-picker-scroll" mode="Vertical" />
            </ui:VisualElement>
            <ui:VisualElement name="design-preview-panel" class="panel design-preview-panel-expanded">
                <ui:Image name="design-preview-viewport" class="design-preview-viewport">
                    <ui:VisualElement name="design-stat-card" class="design-stat-card" />
                </ui:Image>
                <ui:Label text="Test Against" class="part-picker-section-header" />
                <ui:VisualElement name="scenario-picker-content" class="scenario-picker-content" />
                <ui:VisualElement name="deploy-button-row" class="deploy-button-row">
                    <ui:Button name="enter-test-range-button" text="Test Range" class="enter-test-range-button" />
                    <ui:Button name="enter-combat-button" text="Enter Combat" class="enter-combat-button" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
