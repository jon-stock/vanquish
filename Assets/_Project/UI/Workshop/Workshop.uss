.root {
    flex-grow: 1;
    flex-direction: column;
    padding: 12px;
    background-color: rgb(10, 11, 14);
}

.currency-bar {
    flex-direction: row;
    align-items: center;
    align-self: flex-start;
    background-color: rgba(255, 255, 255, 0.05);
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.1);
    padding: 8px 14px;
    margin-bottom: 10px;
}

.currency-bar Label {
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
}

.debug-currency-button {
    margin-left: 16px;
    height: 26px;
    font-size: 12px;
    background-color: rgb(120, 60, 60);
    color: rgb(255, 220, 220);
}

.main-row {
    flex-direction: row;
    flex-grow: 1;
}

.panel {
    background-color: rgba(255, 255, 255, 0.04);
    border-radius: 8px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    padding: 12px;
    margin-right: 10px;
}

#part-picker-panel {
    width: 340px;
    flex-direction: column;
}

#design-preview-panel {
    flex-grow: 1;
    flex-direction: column;
    margin-right: 0;
}

.panel-header {
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    margin-bottom: 8px;
    letter-spacing: 1px;
}

.tech-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 6px 4px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.1);
}

.tech-row-info {
    flex-direction: column;
    flex-grow: 1;
}

.tech-name-label {
    font-size: 15px;
    color: rgb(255, 255, 255);
}

.tech-status-label {
    font-size: 12px;
    color: rgb(160, 165, 175);
}

.unlock-button {
    width: 74px;
    height: 28px;
    font-size: 11px;
}

/* --- Phase 3B follow-up: Craft/Missile designer mode tabs (pulled forward from --- */
/* --- Phase 3C's designer-mode-split, per direct user feedback on this pass) --- */
.designer-mode-tabs {
    flex-direction: row;
    margin-bottom: 10px;
}

.designer-mode-tab {
    flex-grow: 1;
    height: 36px;
    font-size: 15px;
    -unity-font-style: bold;
    background-color: rgba(255, 255, 255, 0.06);
    color: rgb(180, 185, 195);
    border-width: 0;
    border-radius: 0;
    margin: 0;
}

#mode-tab-craft {
    border-top-left-radius: 6px;
    border-bottom-left-radius: 6px;
}

#mode-tab-research {
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
}

.designer-mode-tab-active {
    background-color: rgb(70, 130, 200);
    color: rgb(255, 255, 255);
}

.part-picker-scroll {
    flex-grow: 1;
}

.part-slot-row {
    flex-direction: column;
    padding: 8px 4px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.08);
}

.part-slot-label {
    font-size: 13px;
    color: rgb(160, 165, 175);
    margin-bottom: 4px;
    letter-spacing: 0.5px;
}

/* Dropdown-based part pickers (Phase 3B follow-up) — replaced the original */
/* row-of-buttons-per-slot picker from Phase 2A/2B, which didn't scale well */
/* once every slot had many unlocked options. */
.part-option-dropdown {
    margin: 0;
    height: 32px;
    font-size: 13px;
}

.part-slot-empty-label {
    font-size: 12px;
    color: rgb(180, 180, 180);
    margin: 2px;
}

.part-picker-section-header {
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(140, 190, 255);
    margin-top: 4px;
    margin-bottom: 6px;
    letter-spacing: 1px;
    text-transform: uppercase;
}

.slider-row {
    margin-bottom: 4px;
    padding: 8px 4px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.08);
}

.slider-label {
    font-size: 13px;
    color: rgb(160, 165, 175);
    margin-bottom: 2px;
}

/* --- Big live 3D viewport — Phase 3B follow-up: was a fixed 220px box sharing --- */
/* --- space with a long scrolling text dump; now the dominant element of the --- */
/* --- whole screen, with a compact overlay stat card instead of the text dump. --- */
.design-preview-viewport {
    flex-grow: 1;
    min-height: 420px;
    width: 100%;
    background-color: rgb(14, 15, 19);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
    border-radius: 8px;
    margin-bottom: 10px;
    -unity-background-scale-mode: scale-to-fit;
    justify-content: flex-end;
}

.design-stat-card {
    background-color: rgba(10, 11, 15, 0.78);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
    border-radius: 6px;
    margin: 14px;
    padding: 10px 14px;
    align-self: flex-start;
    min-width: 280px;
}

.design-line {
    font-size: 14px;
    color: rgb(230, 230, 235);
    margin-bottom: 2px;
    white-space: normal;
}

.design-header-line {
    font-size: 16px;
    -unity-font-style: bold;
    margin-top: 4px;
}

.design-line-ready {
    color: rgb(140, 230, 140);
}

.design-line-incomplete {
    color: rgb(230, 140, 140);
}

.scenario-picker-content {
    max-height: 120px;
}

.scenario-row {
    flex-direction: column;
    align-items: flex-start;
    background-color: rgba(255, 255, 255, 0.06);
    border-radius: 4px;
    padding: 6px 8px;
    margin-bottom: 4px;
    height: auto;
    white-space: normal;
}

.scenario-row-selected {
    background-color: rgba(70, 130, 200, 0.35);
    border-left-width: 3px;
    border-left-color: rgb(120, 180, 255);
}

.scenario-row-title {
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    white-space: normal;
}

.scenario-row-summary {
    font-size: 12px;
    color: rgb(200, 200, 200);
    white-space: normal;
    margin-top: 2px;
}

.deploy-button-row {
    flex-direction: row;
    margin-top: 10px;
}

.enter-test-range-button {
    flex-grow: 1;
    height: 46px;
    font-size: 14px;
    margin-right: 8px;
}

.enter-combat-button {
    flex-grow: 2;
    height: 46px;
    font-size: 15px;
    -unity-font-style: bold;
}
