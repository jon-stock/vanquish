.root {
    flex-grow: 1;
    flex-direction: column;
    padding: 12px;
}

.currency-bar {
    flex-direction: row;
    align-items: center;
    align-self: flex-start;
    background-color: rgba(0, 0, 0, 0.65);
    border-radius: 4px;
    padding: 8px 14px;
    margin-bottom: 10px;
}

.currency-bar Label {
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
}

.main-row {
    flex-direction: row;
    flex-grow: 1;
}

.panel {
    background-color: rgba(0, 0, 0, 0.65);
    border-radius: 6px;
    padding: 10px;
    margin-right: 10px;
}

#tech-tree-panel {
    width: 340px;
}

#part-picker-panel {
    width: 320px;
    flex-direction: column;
}

#design-preview-panel {
    width: 380px;
    flex-direction: column;
}

.panel-header {
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    margin-bottom: 8px;
}

.tech-tree-scroll {
    flex-grow: 1;
}

.tech-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 6px 4px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.15);
}

.tech-row-info {
    flex-direction: column;
    flex-grow: 1;
}

.tech-name-label {
    font-size: 16px;
    color: rgb(255, 255, 255);
}

.tech-status-label {
    font-size: 13px;
    color: rgb(200, 200, 200);
}

.unlock-button {
    width: 80px;
    height: 30px;
}

.part-picker-scroll {
    flex-grow: 1;
}

.part-slot-row {
    flex-direction: column;
    padding: 6px 4px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.15);
}

.part-slot-label {
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    margin-bottom: 4px;
}

.part-option-row {
    flex-direction: row;
    flex-wrap: wrap;
}

.part-option-button {
    margin: 2px;
    height: 26px;
    min-width: 60px;
    font-size: 11px;
    white-space: normal;
}

.part-option-button-selected {
    background-color: rgb(70, 130, 200);
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
}

.part-slot-empty-label {
    font-size: 12px;
    color: rgb(180, 180, 180);
    margin: 2px;
}

.slider-row {
    margin-bottom: 8px;
}

.slider-label {
    font-size: 14px;
    color: rgb(220, 220, 220);
    margin-bottom: 2px;
}

.design-preview-content {
    flex-grow: 1;
}

.design-line {
    font-size: 16px;
    color: rgb(255, 255, 255);
    margin-bottom: 2px;
    white-space: normal;
}

.design-header-line {
    -unity-font-style: bold;
    margin-top: 6px;
}

.design-line-ready {
    color: rgb(140, 230, 140);
}

.design-line-incomplete {
    color: rgb(230, 140, 140);
}

.enter-combat-button {
    height: 50px;
    font-size: 16px;
    -unity-font-style: bold;
    margin-top: 12px;
}
