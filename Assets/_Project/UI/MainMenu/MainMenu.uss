.root {
    flex-grow: 1;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background-color: rgb(12, 14, 18);
}

.title-block {
    align-items: center;
    margin-bottom: 48px;
}

.title-label {
    font-size: 56px;
    -unity-font-style: bold;
    letter-spacing: 6px;
    color: rgb(230, 235, 245);
}

.subtitle-label {
    font-size: 16px;
    color: rgb(150, 160, 175);
    margin-top: 6px;
}

.menu-panel {
    flex-direction: column;
    width: 320px;
}

.menu-button {
    height: 52px;
    font-size: 18px;
    margin-bottom: 14px;
    background-color: rgba(255, 255, 255, 0.08);
    color: rgb(220, 220, 220);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.2);
    border-radius: 4px;
}

.menu-button-primary {
    background-color: rgb(70, 130, 200);
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    border-color: rgb(100, 160, 230);
}
